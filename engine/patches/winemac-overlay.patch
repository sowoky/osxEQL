#
# Adds two opt-in, per-app registry knobs to winemac.drv
# (HKCU\Software\Wine\AppDefaults\<exe>\Mac Driver):
#   LetTopmostWindowsFloatOverFullscreen — a topmost window of that exe floats
#       above ANOTHER process's fullscreen window (EQBuddy over eqgame).
#   KeepFullscreenWhenInactive — a fullscreen window stays above the menu bar
#       when its app deactivates.
# Both default off: a stock prefix behaves exactly as before.
# Applied by engine/overlay.sh (winemac.so only) and engine/build-wine.sh.
--- a/dlls/winemac.drv/macdrv_cocoa.h	2026-08-15 14:32:23
+++ b/dlls/winemac.drv/macdrv_cocoa.h	2026-08-15 14:32:23
@@ -131,6 +131,8 @@
 extern bool macdrv_err_on;
 extern int topmost_float_inactive;
 extern bool capture_displays_for_fullscreen;
+extern bool topmost_float_over_fullscreen;
+extern bool keep_fullscreen_when_inactive;
 /* CrossOver Hack 10912: Mac Edit menu */
 extern int mac_edit_menu;
 extern bool left_option_is_alt;
--- a/dlls/winemac.drv/macdrv_main.c	2026-08-15 14:32:23
+++ b/dlls/winemac.drv/macdrv_main.c	2026-08-15 14:32:23
@@ -44,6 +44,8 @@
 
 int topmost_float_inactive = TOPMOST_FLOAT_INACTIVE_NONFULLSCREEN;
 bool capture_displays_for_fullscreen = false;
+bool topmost_float_over_fullscreen = false;
+bool keep_fullscreen_when_inactive = false;
 BOOL allow_vsync = TRUE;
 BOOL allow_set_gamma = TRUE;
 /* CrossOver Hack 10912: Mac Edit menu */
@@ -325,7 +327,13 @@
 
     if (!get_config_key(hkey, appkey, "CaptureDisplaysForFullscreen", buffer, sizeof(buffer)))
         capture_displays_for_fullscreen = IS_OPTION_TRUE(buffer[0]);
+
+    if (!get_config_key(hkey, appkey, "LetTopmostWindowsFloatOverFullscreen", buffer, sizeof(buffer)))
+        topmost_float_over_fullscreen = IS_OPTION_TRUE(buffer[0]);
 
+    if (!get_config_key(hkey, appkey, "KeepFullscreenWhenInactive", buffer, sizeof(buffer)))
+        keep_fullscreen_when_inactive = IS_OPTION_TRUE(buffer[0]);
+
     if (!get_config_key(hkey, appkey, "AllowVerticalSync", buffer, sizeof(buffer)))
         allow_vsync = IS_OPTION_TRUE(buffer[0]);
 
--- a/dlls/winemac.drv/cocoa_window.m	2026-08-15 14:32:23
+++ b/dlls/winemac.drv/cocoa_window.m	2026-08-15 14:32:23
@@ -1268,7 +1268,26 @@
                     level++;
             }
         }
+        /* Opt-in (HKCU\...\Mac Driver\KeepFullscreenWhenInactive): a borderless
+         * fullscreen game window drops to NSNormalWindowLevel when its app
+         * deactivates (the user clicks another app or monitor), so the menu bar
+         * shows over it. Keep it above the menu bar while inactive so the game
+         * stays visually fullscreen. Below the overlay's shield+2, so a widget with
+         * the float-over-fullscreen key still sits on top. */
+        if (!active && fullscreen && keep_fullscreen_when_inactive)
+            level = NSStatusWindowLevel + 1;
 
+        /* Opt-in (HKCU\...\Mac Driver\LetTopmostWindowsFloatOverFullscreen):
+         * keep a topmost overlay above ANOTHER process's active fullscreen window,
+         * which reaches at most CGShieldingWindowLevel()+1 (the captured branch
+         * above), so +2 clears it. Applies whether or not THIS window is active,
+         * so a non-activating overlay (WS_EX_NOACTIVATE) that a click makes key
+         * doesn't fall back to the floating floor and drop behind the game.
+         * Only affects floating windows of a process that set the key; default-off
+         * leaves all other windows untouched. */
+        if (self.floating && topmost_float_over_fullscreen)
+            level = CGShieldingWindowLevel() + 2;
+
         return level;
     }
 
